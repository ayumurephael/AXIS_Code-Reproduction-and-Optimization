{
  "seed": 1001,
  "data": {
    "output_dir": "outputs/runs/doflow_axis_qa_compare10/data",
    "num_base_systems": 64,
    "length": 160,
    "num_channels": 10,
    "alpha_values": [
      0.0,
      0.2,
      0.6,
      1.0
    ],
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "noise_scale": 0.05,
    "graph_density": 0.35,
    "causal_graph": {
      "graph_types": [
        "tree",
        "diamond",
        "fc_layer",
        "chain"
      ],
      "mechanisms": [
        "additive",
        "nonlinear"
      ],
      "chain_num_channels": 10,
      "coefficient_jitter": 0.04
    }
  },
  "model": {
    "backend": "torch_axis",
    "device": "auto",
    "feature_dim": 10,
    "metadata_dim": 10,
    "top_k_channels": 3,
    "batch_size": 24,
    "dropout": 0.1,
    "hint_hidden_dim": 64,
    "temporal_loss_weight": 1.5,
    "ts_encoder": {
      "d_model": 96,
      "d_proj": 32,
      "patch_size": 16,
      "num_layers": 3,
      "num_heads": 4,
      "dropout": 0.1,
      "max_patches": 16
    }
  },
  "train_encoder": {
    "epochs": 30,
    "learning_rate": 0.0008,
    "pos_weight": 5.0,
    "checkpoint_path": "outputs/checkpoints/encoder_semantic_scale.pt"
  },
  "train_hint_tuner": {
    "epochs": 12,
    "learning_rate": 0.0008,
    "checkpoint_path": "outputs/checkpoints/hint_tuner_semantic_scale.pt"
  },
  "train_interval_proposal": {
    "epochs": 35,
    "learning_rate": 0.0008,
    "weight_decay": 0.0001,
    "pos_weight": 10.0,
    "batch_size": 24,
    "checkpoint_path": "outputs/checkpoints/axis_interval_proposer_semantic_scale.pt"
  },
  "interval_proposal": {
    "window_size": 32,
    "stride": 8,
    "threshold": 0.5,
    "min_iou": 0.25
  },
  "outputs": {
    "report_path": "outputs/runs/doflow_axis_qa_compare10/local_report.json",
    "sample_prompt_path": "outputs/runs/doflow_axis_qa_compare10/sample_prompt.txt"
  }
}
