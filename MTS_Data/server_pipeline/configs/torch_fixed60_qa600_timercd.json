{
  "seed": 73,
  "data": {
    "output_dir": "outputs/runs/fixed60_qa600_legacy_dag/data",
    "generator_backend": "legacy_tsad",
    "num_channels": 10,
    "length": 180
  },
  "model": {
    "backend": "torch_axis",
    "device": "auto",
    "feature_dim": 10,
    "metadata_dim": 10,
    "top_k_channels": 3,
    "batch_size": 16,
    "dropout": 0.0,
    "ts_encoder": {
      "d_model": 512,
      "d_proj": 256,
      "patch_size": 16,
      "num_layers": 8,
      "num_heads": 8,
      "dropout": 0.0,
      "max_total_tokens": 8192,
      "use_rope": true,
      "activation": "gelu"
    },
    "global_hint_head": {
      "d_model": 512,
      "num_layers": 3,
      "num_heads": 8,
      "dropout": 0.1,
      "num_global_tokens": 8,
      "use_anomaly_probs": true
    }
  },
  "train_encoder": {
    "epochs": 0,
    "learning_rate": 0.0,
    "checkpoint_path": "outputs/checkpoints/unused_encoder_for_timercd.pt"
  },
  "train_hint_tuner": {
    "epochs": 0,
    "learning_rate": 0.0,
    "checkpoint_path": "outputs/checkpoints/unused_hint_tuner_for_timercd.pt"
  },
  "train_interval_proposal": {
    "epochs": 0,
    "learning_rate": 0.0,
    "checkpoint_path": "external_checkpoints/timercd/best_model/pretrain_checkpoint_best_multi.pth"
  },
  "interval_proposal": {
    "window_size": 32,
    "stride": 8,
    "threshold": 0.5,
    "min_iou": 0.25
  },
  "outputs": {
    "report_path": "outputs/runs/fixed60_qa600_timercd/report.json",
    "sample_prompt_path": "outputs/runs/fixed60_qa600_timercd/sample_prompt.txt"
  }
}
